{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["schema.graphql.ts", "scalars.ts", "graphql.config.ts", "documents/**/*.ts", "typecheck/**/*.ts", "probes/**/*.ts"]
}
